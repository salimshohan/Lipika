      "keys": [
        { "label": "q", "flickUp": "1", "moreKeys": ["1", "!", "`", "¬"] },
        { "label": "w", "flickUp": "2", "moreKeys": ["2", "@", "₩", "§"] },
        { "label": "e", "flickUp": "3", "moreKeys": ["3", "é", "è", "ê", "ë", "ē", "ė", "ę", "€"] },
        { "label": "r", "flickUp": "4", "moreKeys": ["4", "$", "₹", "®"] },
        { "label": "t", "flickUp": "5", "moreKeys": ["5", "%", "™", "þ"] },
        { "label": "y", "flickUp": "6", "moreKeys": ["6", "^", "¥", "ý", "ÿ"] },
        { "label": "u", "flickUp": "7", "moreKeys": ["7", "ú", "ù", "û", "ü", "ū", "ů"] },
        { "label": "i", "flickUp": "8", "moreKeys": ["8", "í", "ì", "î", "ï", "ī", "ı"] },
        { "label": "o", "flickUp": "9", "moreKeys": ["9", "ó", "ò", "ô", "ö", "ō", "œ", "ø"] },
        { "label": "p", "flickUp": "0", "moreKeys": ["0", "*", "π", "¶"] }
      ]
    },
    {
      "keys": [
        { "label": "a", "flickUp": "@", "moreKeys": ["á", "à", "â", "ä", "ā", "ą", "æ", "å"] },
        { "label": "s", "flickUp": "#", "moreKeys": ["ß", "š", "ś", "ş", "$"] },
        { "label": "d", "flickUp": "$", "moreKeys": ["&", "ð", "ď", "đ"] },
        { "label": "f", "flickUp": "%", "moreKeys": ["_", "ſ", "ƒ"] },
        { "label": "g", "flickUp": "&", "moreKeys": ["-", "ğ", "ģ"] },
        { "label": "h", "flickUp": "*", "moreKeys": ["+", "ħ", "ḥ"] },
        { "label": "j", "flickUp": "-", "moreKeys": ["=", "ĵ"] },
        { "label": "k", "flickUp": "+", "moreKeys": ["(", "ķ"] },
        { "label": "l", "flickUp": "=", "moreKeys": [")", "ł", "ľ", "ļ"] }
      ]
    },
    {
      "keys": [
        { "type": "shift", "icon": "shift", "width": 1.5 },
        { "label": "z", "flickUp": "_", "moreKeys": ["ACTION_SELECT_ALL", "/", "ž", "ź", "ż"] },
        { "label": "x", "flickUp": "\"", "moreKeys": ["ACTION_CUT", "\\", "×"] },
        { "label": "c", "flickUp": "'", "moreKeys": ["ACTION_COPY", "ç", "ć", "č", "©", "¢"] },
        { "label": "v", "flickUp": ":", "moreKeys": ["ACTION_PASTE", "\"", "✓"] },
        { "label": "b", "flickUp": ";", "moreKeys": ["[", "•"] },
        { "label": "n", "flickUp": "!", "moreKeys": ["]", "ñ", "ń", "ņ", "ň"] },
        { "label": "m", "flickUp": "?", "moreKeys": ["¿", "µ"] },
        { "type": "delete", "icon": "backspace", "width": 1.5 }
      ]
    },
    {
      "keys": [
        { "type": "symbols", "label": "?123", "slidingInput": true, "width": 1.5 },
        { "label": ",", "flickUp": "<", "moreKeys": ["<", "«"], "width": 1.0 },
        { "type": "space", "icon": "space", "width": 5.0 },
        { "label": ".", "flickUp": ">", "moreKeys": [">", "»", "…"], "width": 1.0 },
